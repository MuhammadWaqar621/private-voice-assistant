# Groq powers the entire voice pipeline: speech-to-text (Whisper),
# the conversational LLM (Llama), and text-to-speech (PlayAI TTS).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
# Orpheus requires one-time terms acceptance in the Groq console:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Until accepted, the backend falls back to text-only replies and the
# frontend speaks them with the browser's built-in voice instead.

# Comma-separated exact origin(s) the browser demo's frontend is served
# from, in addition to localhost/127.0.0.1 (always allowed, any port -
# see app/main.py). Needed whenever frontend and backend are deployed to
# different origins - which they are on Vercel (one project per side, see
# README's "Deploying on Vercel" section) - since the browser will
# otherwise get a silent CORS failure calling this API from the deployed
# frontend's origin. Example: https://your-app.vercel.app
FRONTEND_ORIGIN=

# --- Real phone calls via Twilio (optional - NOT available on a Vercel
# deployment of this backend - see README's "Deploying on Vercel" section
# for why: Twilio's own webhook flow here is plain HTTP, not a WebSocket,
# but the in-memory per-call state in app/conversation_store.py isn't
# reliably shared across Vercel's serverless instances/cold starts. Only
# needed if you want an actual phone number to reach this app, not just
# the browser demo, and only works when the backend runs as a normal
# long-lived process (uvicorn/Docker - see README) rather than on Vercel.
# Leave blank to skip Twilio entirely. ---

# Which company (see backend/app/company_profile.py) answers calls to
# your Twilio number - same idea as the browser demo's setup form, but
# fixed here since a phone call has no form to fill in. A production
# system with multiple numbers would look this up per-number instead of
# one fixed pair of values. TWILIO_COMPANY_DETAILS can be multi-line.
TWILIO_COMPANY_NAME=
TWILIO_COMPANY_DETAILS=

# The publicly reachable URL Twilio can fetch synthesized reply audio
# from - a plain localhost URL is useless to Twilio's servers. For local
# testing, run `ngrok http 8010` and paste the https://*.ngrok-free.app
# URL it prints. For a real deployment, this is wherever the backend is
# actually hosted - which, again, cannot be Vercel for the Twilio path
# (see the note above); this only applies to a non-Vercel deployment of
# this backend (a VM, container host, etc.) alongside Vercel for the
# browser-demo frontend, or not using Vercel at all.
PUBLIC_BASE_URL=

# From your Twilio console (console.twilio.com) - not read by this app's
# code directly (Twilio calls your webhook, your app doesn't call
# Twilio's API), but keeping them here documents what the number's
# webhook config needs and is where you'd wire in request-signature
# validation if you harden this beyond a demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

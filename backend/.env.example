# Groq powers the entire voice pipeline: speech-to-text (Whisper),
# the conversational LLM (Llama), and text-to-speech (PlayAI TTS).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
# Orpheus requires one-time terms acceptance in the Groq console:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Until accepted, the backend falls back to text-only replies and the
# frontend speaks them with the browser's built-in voice instead.

# --- Real phone calls via Twilio (optional - see README's Twilio section) ---
# Only needed if you want an actual phone number to reach this app, not
# just the browser demo. Leave blank to skip Twilio entirely.

# Which company (see backend/app/company_profile.py) answers calls to
# your Twilio number - same idea as the browser demo's setup form, but
# fixed here since a phone call has no form to fill in. A production
# system with multiple numbers would look this up per-number instead of
# one fixed pair of values. TWILIO_COMPANY_DETAILS can be multi-line.
TWILIO_COMPANY_NAME=
TWILIO_COMPANY_DETAILS=

# The publicly reachable URL Twilio can fetch synthesized reply audio
# from - a plain localhost URL is useless to Twilio's servers. For local
# testing, run `ngrok http 8010` and paste the https://*.ngrok-free.app
# URL it prints. For a real deployment, this is wherever the backend is
# actually hosted.
PUBLIC_BASE_URL=

# From your Twilio console (console.twilio.com) - not read by this app's
# code directly (Twilio calls your webhook, your app doesn't call
# Twilio's API), but keeping them here documents what the number's
# webhook config needs and is where you'd wire in request-signature
# validation if you harden this beyond a demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
